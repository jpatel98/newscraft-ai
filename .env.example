# --- network ---
PORT=3001
HOST=127.0.0.1
# Leave ORIGIN unset; SvelteKit derives the URL from X-Forwarded-* headers
# below so the same build works behind a reverse proxy AND on a direct/tunnel
# connection. Only set ORIGIN if you want to pin it to one URL.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# --- Hermes runtime ---
# NewsCraft calls this URL from the server. The browser never calls Hermes.
# There is no default and no legacy agent fallback.
NEWSCRAFT_HERMES_URL=http://127.0.0.1:8000
NEWSCRAFT_HERMES_API_TOKEN=
# Server-only HMAC secret for the opaque account namespace sent to Hermes.
# Generate with: openssl rand -hex 32
NEWSCRAFT_HERMES_TENANT_SECRET=

# Agentic browser research can take several minutes. The server counts idle
# time only while Hermes has no active tool call.
NEWSCRAFT_CHAT_STREAM_MAX_MS=290000
NEWSCRAFT_CHAT_STREAM_IDLE_MS=90000

# --- app auth ---
# Optional legacy/bootstrap gate for creating the first account.
# Generate with: pnpm exec node scripts/hash-password.mjs '<your-password>'
APP_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SESSION_SECRET=

# --- persistence ---
# Server-only Postgres URI for the non-superuser NewsCraft app login. During
# the migration this remains the Supabase source; after cutover it points at
# the isolated NewsCraft Postgres service. Use the separate admin DSN only for
# reviewed migrations/backups.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set NEWSCRAFT_STORAGE_MODE=vps only after the Contabo gateway and private policy check
# pass. Keep the Supabase values during the rollback window.
NEWSCRAFT_STORAGE_MODE=supabase
NEWSCRAFT_STORAGE_BASE_URL=
NEWSCRAFT_STORAGE_API_KEY=
NEWSCRAFT_DOCUMENT_STORAGE_BUCKET=newsroom-documents
NEWSCRAFT_ARTIFACT_STORAGE_BUCKET=newsroom-artifacts
# Server-only Supabase Storage credentials for the rollback window. Never
# prefix these with PUBLIC_ or expose the service-role key to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Linear feedback tracking ---
# Optional. When set, /feedback creates a Linear issue after storing the local
# feedback snapshot. Keep the API key in deployment secrets, not source control.
LINEAR_API_KEY=
LINEAR_FEEDBACK_TEAM_ID=
LINEAR_FEEDBACK_PROJECT_ID=
LINEAR_FEEDBACK_LABEL_IDS=
# Optional public app URL used in Linear issue descriptions.
LINEAR_FEEDBACK_APP_URL=

# Optional Phase 3 delivery channels. Keep real URLs and credentials in local
# env or deployment secrets; they are not written to story memory.
NEWSROOM_EMAIL_DIGEST_WEBHOOK_URL=
NEWSROOM_SLACK_WEBHOOK_URL=
