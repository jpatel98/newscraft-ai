# App listener behind the trusted reverse proxy.
PORT=3001
HOST=127.0.0.1
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=x-forwarded-host

# The app calls the durable worker server-side; browsers use saved app events.
NEWSCRAFT_AGENT_URL=http://127.0.0.1:8000
NEWSCRAFT_AGENT_API_TOKEN=
NEWSCRAFT_AGENT_TENANT_SECRET=
NEWSCRAFT_AGENT_RUN_API_TOKEN=
NEWSCRAFT_CHAT_STREAM_MAX_MS=290000
NEWSCRAFT_CHAT_STREAM_IDLE_MS=90000

# Ordinary Postgres. For this checkout use the initialized new project described
# in docs/agent-local-handoff.md; enter its URL privately in .env.agent-local.
# Do not rerun initialization or reuse the old database target.
# Hosted connections require sslmode=verify-full. Before starting local Node,
# export NODE_EXTRA_CA_CERTS="$PWD/config/certs/supabase-prod-ca-2021.crt"
# See config/certs/README.md for the public CA source and verification details.
DATABASE_URL=postgresql://<user>:<password>@<database-host>:5432/<database>?sslmode=verify-full
NEWSCRAFT_AUTH_PROVIDER=postgres
# Existing server-side signing secret, at least 32 decoded base64 bytes.
APP_SESSION_SECRET=

# Existing private object service (default). No cloud provider is mandatory.
NEWSCRAFT_STORAGE_PROVIDER=vps
NEWSCRAFT_STORAGE_BASE_URL=
NEWSCRAFT_STORAGE_API_KEY=
NEWSCRAFT_DOCUMENT_STORAGE_BUCKET=newsroom-documents
NEWSCRAFT_ARTIFACT_STORAGE_BUCKET=newsroom-artifacts
# Artifact-only development alternative: provider=local plus LOCAL_STORAGE=1.
NEWSCRAFT_ARTIFACT_LOCAL_STORAGE=0
NEWSCRAFT_ARTIFACT_STORAGE_DIR=/private/tmp/newscraft-artifacts

# Optional isolated Supabase adapters, selected explicitly with *_PROVIDER=supabase.
# Select explicitly only when approved. Local fixture tests do not verify cloud access.
# SUPABASE_URL=https://<new-project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY is a compatibility alias. Keep all credentials server-only.

# Optional Linear feedback delivery, only when explicitly configured.
LINEAR_API_KEY=
LINEAR_FEEDBACK_TEAM_ID=
LINEAR_FEEDBACK_PROJECT_ID=
LINEAR_FEEDBACK_LABEL_IDS=
LINEAR_FEEDBACK_APP_URL=
NEWSROOM_EMAIL_DIGEST_WEBHOOK_URL=
NEWSROOM_SLACK_WEBHOOK_URL=
