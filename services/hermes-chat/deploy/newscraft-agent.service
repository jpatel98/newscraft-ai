[Unit]
Description=NewsCraft owned research worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newscraft-agent
Group=newscraft-agent
WorkingDirectory=/opt/newscraft-agent/service
EnvironmentFile=/etc/newscraft-agent.env
Environment=NEWSCRAFT_AGENT_MAX_STEPS=12
ExecStart=/opt/newscraft-agent/venv/bin/newscraft-agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# The worker needs model/public-web HTTPS egress, private app callbacks
# and private staging. It does not expose a code-execution sandbox.
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/newscraft-agent
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
