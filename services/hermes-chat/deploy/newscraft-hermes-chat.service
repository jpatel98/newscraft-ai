[Unit]
Description=NewsCraft standard Hermes chat runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newscraft-hermes
Group=newscraft-hermes
WorkingDirectory=/var/lib/newscraft-hermes/workspace
EnvironmentFile=/etc/newscraft-hermes-chat.env
Environment=PATH=/var/lib/newscraft-hermes/home/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=AGENT_BROWSER_ENGINE=chrome
Environment=AGENT_BROWSER_HEADED=false
Environment=AGENT_BROWSER_DEFAULT_TIMEOUT=120000
Environment=NEWSCRAFT_HERMES_MAX_ITERATIONS=25
ExecStart=/opt/newscraft-hermes/venv/bin/newscraft-hermes-chat
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/newscraft-hermes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
