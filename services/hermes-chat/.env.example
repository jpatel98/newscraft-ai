# NewsCraft owns the model/tool loop. No managed agent harness is used.
# Local setup: docs/agent-local-handoff.md, CPython 3.11 in .venv-owned.
# Offline fixtures are verified; live provider and Linux acceptance remain blocked.
NEWSCRAFT_AGENT_HOST=127.0.0.1
NEWSCRAFT_AGENT_PORT=8000
NEWSCRAFT_AGENT_PUBLIC_HOST=
# Match the app API token; at least 24 characters.
NEWSCRAFT_AGENT_SESSION_TOKEN=
NEWSCRAFT_AGENT_STATE_HOME=/var/lib/newscraft-agent/state
NEWSCRAFT_AGENT_WORKSPACE=/var/lib/newscraft-agent/workspace

# Select openai, anthropic or deepseek. Anthropic requires an explicit model name.
NEWSCRAFT_AGENT_MODEL_PROVIDER=openai
NEWSCRAFT_AGENT_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1
# Reuse an approved existing key via private service injection or file reference.
# Never commit/copy credentials. The file reader selects OPENAI_API_KEY for OpenAI,
# or DEEPSEEK_API_KEY for DeepSeek. Optional OpenAI search selects its own key.
NEWSCRAFT_AGENT_CREDENTIAL_FILE=
# ANTHROPIC_API_KEY is injected privately when selecting anthropic.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DeepSeek uses Messages with thinking disabled; no Anthropic service_tier is sent.
# Set provider=deepseek, model=deepseek-flash (or explicitly deepseek-v4-pro).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_API_KEY is injected privately or read from the approved credential file.
# deepseek-chat/deepseek-reasoner are retired and rejected, never silently mapped.
# See docs/managed-agent-setup.md for current prices and the $0.06 Flash profile.

# Public DDGS discovery is independent of the model provider.
NEWSCRAFT_AGENT_WEB_PROVIDER=public
# Optional computer access on an existing non-root Linux worker only.
# Requires a reviewed immutable image already present in a private rootless
# Docker daemon with cgroup v2/systemd limits. No auto-provisioning or image pull.
# NEWSCRAFT_EXECUTOR_IMAGE=sha256:<64-hex-reviewed-image-id>
# NEWSCRAFT_EXECUTOR_SOCKET=/run/user/<worker-uid>/docker.sock
# NEWSCRAFT_EXECUTOR_DOCKER_BIN=/usr/bin/docker
# Interactive browsing adds a separate container and private conversation profile.
# All three values are required. Activation needs approval of the existing host,
# immutable browser image and deny-by-default Chromium user-namespace policy.
# Nothing installs or changes host permissions automatically; see deploy/executor.md.
# NEWSCRAFT_BROWSER_IMAGE=sha256:<64-hex-reviewed-browser-image-id>
# NEWSCRAFT_BROWSER_SECCOMP_PROFILE=/etc/newscraft-agent/chromium-seccomp.json
# NEWSCRAFT_BROWSER_SECCOMP_SHA256=<64-hex-reviewed-policy-sha256>
# Optional paid OpenAI search uses a separate bounded Responses request.
NEWSCRAFT_SEARCH_MODEL=gpt-6-astra
NEWSCRAFT_SEARCH_BASE_URL=https://api.openai.com/v1
NEWSCRAFT_AGENT_MAX_SEARCH_CALLS=5
NEWSCRAFT_AGENT_SEARCH_CALL_PRICE_CEILING=

# Required reviewed model prices: USD per MILLION tokens, no price defaults.
# Cover cache-write/long-context multipliers; OpenAI selects service_tier=default
# and Anthropic selects service_tier=standard_only.
# DeepSeek floors checked 2026-10-07: Flash input=0.30/output=1.20; Pro=1.32/3.96.
# These are peak cache-miss USD/M rates, not cached/off-peak discounts or defaults.
# Optional paid search ceiling above covers the ENTIRE request/tool charge.
# Local conservative reservations are not provider-enforced billing guarantees.
NEWSCRAFT_AGENT_INPUT_PRICE_CEILING=
NEWSCRAFT_AGENT_OUTPUT_PRICE_CEILING=
NEWSCRAFT_AGENT_IMAGE_TOKEN_CEILING=32768
NEWSCRAFT_AGENT_MAX_INPUT_TOKENS=120000
NEWSCRAFT_AGENT_MAX_OUTPUT_TOKENS=4096
NEWSCRAFT_AGENT_MAX_COST_USD=2
NEWSCRAFT_AGENT_MAX_STEPS=12
NEWSCRAFT_AGENT_MAX_SECONDS=180
NEWSCRAFT_AGENT_MAX_ACTIVE_RUNS=4
NEWSCRAFT_AGENT_MAX_ACTIVE_RUNS_PER_TENANT=2
NEWSCRAFT_AGENT_MAX_QUEUED_RUNS=16
NEWSCRAFT_AGENT_MAX_QUEUED_RUNS_PER_TENANT=4

# Private app callback endpoint, e.g. https://<app>/api/internal/hermes/runs.
NEWSCRAFT_AGENT_RUN_API_URL=
NEWSCRAFT_AGENT_RUN_API_TOKEN=
