# AG-UI listener. Keep Hermes on loopback behind the VPS reverse proxy.
HERMES_AGUI_HOST=127.0.0.1
HERMES_AGUI_PORT=8000
# Exact HTTPS hostname used by the trusted reverse proxy. Do not include a URL or port.
NEWSCRAFT_HERMES_PUBLIC_HOST=
# Generate a separate value with: openssl rand -hex 32
HERMES_AGUI_SESSION_TOKEN=

# Dedicated directories. Do not use a personal Hermes home or the NewsCraft checkout.
NEWSCRAFT_HERMES_HOME=/var/lib/newscraft-hermes/home
NEWSCRAFT_HERMES_WORKSPACE=/var/lib/newscraft-hermes/workspace
AGENT_BROWSER_ENGINE=chrome
AGENT_BROWSER_HEADED=false
AGENT_BROWSER_DEFAULT_TIMEOUT=120000
# Optional when Chrome is outside the service user's normal home.
AGENT_BROWSER_EXECUTABLE_PATH=

# Pin one model endpoint, provider label, and model.
NEWSCRAFT_HERMES_MODEL_PROVIDER=
NEWSCRAFT_HERMES_MODEL=
NEWSCRAFT_HERMES_MODEL_BASE_URL=
NEWSCRAFT_HERMES_MODEL_API_KEY=
# Optional. Leave empty unless the endpoint needs an explicit Hermes API mode.
NEWSCRAFT_HERMES_MODEL_API_MODE=

# Native Hermes model-turn budget for one NewsCraft request. The same Hermes
# run writes its best final summary when it reaches this limit. No fallback runs.
NEWSCRAFT_HERMES_MAX_ITERATIONS=25

# NewsCraft web extraction. This backend uses no API key.
NEWSCRAFT_RETRIEVAL_ENABLED=true
NEWSCRAFT_RETRIEVAL_LIVE_TIMEOUT_MS=8000
NEWSCRAFT_RETRIEVAL_ARCHIVE_TIMEOUT_MS=6000
NEWSCRAFT_RETRIEVAL_MAX_URLS=5
NEWSCRAFT_RETRIEVAL_ARCHIVE_FALLBACK=true

# The service uses Hermes's normal tools. Main and auxiliary model calls use
# this one endpoint. The package includes DDGS. Hermes uses its browser to read pages.
