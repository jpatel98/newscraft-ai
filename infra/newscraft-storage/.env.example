# Generate both secrets with: openssl rand -hex 32
NEWSCRAFT_STORAGE_API_KEY=
NEWSCRAFT_STORAGE_SIGNING_KEY=
# Tailscale Funnel URL, for example https://contabo.tail9ffe16.ts.net:10000
NEWSCRAFT_STORAGE_PUBLIC_URL=
# Origin allowed to upload PDFs directly from the NewsCraft browser.
# Comma-separated exact origins are accepted; wildcard (*) is rejected.
NEWSCRAFT_STORAGE_CORS_ORIGIN=https://agent.newscraftai.com
NEWSCRAFT_STORAGE_ROOT=/srv/newscraft-storage
NEWSCRAFT_DOCUMENT_BUCKET=newsroom-documents
NEWSCRAFT_ARTIFACT_BUCKET=newsroom-artifacts
PORT=9100
